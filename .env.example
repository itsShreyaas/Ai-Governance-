# ─── Database ────────────────────────────────────────────────────────────────
# Single-node replica set for local development (transactions require one).
# For Atlas: mongodb+srv://<user>:<pass>@<cluster>/<dbname>
MONGODB_URI=mongodb://localhost:27017/aegisai?replicaSet=rs0

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_me_before_use
JWT_REFRESH_SECRET=change_me_before_use_different_value

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# ─── Notifications (optional) ────────────────────────────────────────────────
SMTP_URL=
SLACK_WEBHOOK_URL=

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
